generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  POD_LEAD
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  AT_RISK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum PhaseType {
  DIAGNOSE
  DESIGN
  DEPLOY
  EXECUTE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile Client?
  managedProjects Project[] @relation("PodLeadProjects")
  changeRequests ChangeRequest[]
  comments      Comment[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id          String    @id @default(cuid())
  name        String
  company     String
  email       String    @unique
  phone       String?
  industry    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  projects    Project[]
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String?
  status           ProjectStatus @default(ACTIVE)
  priority         Priority      @default(MEDIUM)
  progress         Int           @default(0) // 0-100
  startDate        DateTime
  targetEndDate    DateTime
  actualEndDate    DateTime?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  podLeadId        String?
  podLead          User?         @relation("PodLeadProjects", fields: [podLeadId], references: [id])

  phases           Phase[]
  changeRequests   ChangeRequest[]
  comments         Comment[]
}

model Phase {
  id                 String      @id @default(cuid())
  type               PhaseType
  name               String
  order              Int
  durationDays       Int         @default(7)
  plannedStartDate   DateTime
  plannedEndDate     DateTime
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  status             PhaseStatus @default(NOT_STARTED)
  progress           Int         @default(0)
  deliverables       String?
  clientDependencies String?
  internalNotes      String?
  clientNotes        String?
  bufferDays         Int         @default(0)
  isManualOverride   Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  projectId          String
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks              Task[]
  changeRequests     ChangeRequest[] @relation("ImpactedPhases")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phaseId     String
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model ChangeRequest {
  id                    String   @id @default(cuid())
  title                 String
  description           String
  reason                String
  daysAdded             Int      @default(0)
  dateOfChange          DateTime @default(now())
  newProjectedCompletion DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User     @relation(fields: [createdById], references: [id])
  impactedPhases        Phase[]  @relation("ImpactedPhases")
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}
